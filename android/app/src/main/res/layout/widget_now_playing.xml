<?xml version="1.0" encoding="utf-8"?>
<!-- Compact now playing widget (4x1). Shares view ids with widget_now_playing_large. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/widget_padding">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="@dimen/widget_art_size"
        android:layout_height="match_parent"
        android:maxHeight="@dimen/widget_art_size"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_album_art"
        android:scaleType="fitCenter"
        android:src="@mipmap/ic_launcher" />

    <LinearLayout
        android:id="@+id/widget_text"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_nothing_playing"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_tap_to_open"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_previous"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_previous"
            android:padding="8dp"
            android:src="@drawable/ic_widget_previous"
            android:tint="@color/widget_on_surface_variant" />

        <ImageView
            android:id="@+id/widget_play_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_play_background"
            android:contentDescription="@string/widget_play"
            android:padding="8dp"
            android:src="@drawable/ic_widget_play"
            android:tint="@color/widget_on_primary" />

        <ImageView
            android:id="@+id/widget_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_next"
            android:padding="8dp"
            android:src="@drawable/ic_widget_next"
            android:tint="@color/widget_on_surface_variant" />
    </LinearLayout>
</LinearLayout>
